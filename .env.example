ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
ANTHROPIC_MODEL=MiniMax-M2.7-highspeed
LLM_TIMEOUT_SECONDS=60
SEARCH_TIMEOUT_SECONDS=240
MAX_LLM_PLANNED_QUERIES=12
MAX_SEED_URLS_PER_ENTITY=20
MAX_SITEMAP_URLS_PER_ENTITY=800
MAX_CANDIDATE_PAGES=120
MAX_EXTRACTED_PAGES=50
MAX_CONCURRENT_EXTRACTIONS=3
MAX_FULLTEXT_CHARS_PER_PAGE=30000
MAX_FETCH_BYTES_PER_PAGE=10485760
OFFICIAL_ONLY=true
PERSIST_RESULTS=false
ENABLE_PUBLIC_SEARCH_PAGE_FALLBACK=false
ENABLE_WEB_SEARCH=true
ANYSEARCH_API_KEY=
ANYSEARCH_ENDPOINT=https://api.anysearch.com/v1/search
ANYSEARCH_ZONE=cn
MAX_WEB_SEARCH_RESULTS=12
MAX_WEB_SEARCH_QUERIES=4
WEB_SEARCH_TIMEOUT_SECONDS=20
ENABLE_SCRAPLING_FALLBACK=true
